# ---------------------------------------------------------------
# Aplicação
# ---------------------------------------------------------------
APP_NOME="HE 3D Labs — Integrador"
APP_URL=http://localhost:8090
APP_TIMEZONE=America/Sao_Paulo
APP_DEBUG=true

# Chave de 32 bytes em base64, usada para criptografar tokens no banco.
# Gere com: php bin/chave.php
# ATENÇÃO: trocar esta chave torna ilegíveis os tokens já gravados.
APP_KEY=

# ---------------------------------------------------------------
# Banco de dados
# ---------------------------------------------------------------
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=he3d_labs
DB_USER=root
DB_PASS=

# ---------------------------------------------------------------
# Mercado Livre
# Credenciais em https://developers.mercadolivre.com.br/devcenter
# A redirect URI precisa ser HTTPS e idêntica à cadastrada no app.
# ---------------------------------------------------------------
ML_CLIENT_ID=
ML_CLIENT_SECRET=
ML_REDIRECT_URI=https://seudominio.com.br/canais/mercadolivre/callback
ML_SITE_ID=MLB

# ---------------------------------------------------------------
# Shopee
# Credenciais em https://open.shopee.com
# ---------------------------------------------------------------
SHOPEE_PARTNER_ID=
SHOPEE_PARTNER_KEY=
SHOPEE_REDIRECT_URI=https://seudominio.com.br/canais/shopee/callback
# Produção: https://partner.shopeemobile.com
# Sandbox:  https://partner.test-stable.shopeemobile.com
SHOPEE_HOST=https://partner.shopeemobile.com

# ---------------------------------------------------------------
# Fila
# ---------------------------------------------------------------
FILA_MAX_TENTATIVAS=5
FILA_JOBS_POR_EXECUCAO=10
